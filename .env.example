# Copy to .env and fill in. Never commit the real .env file.
# For local dev with `docker-compose up`, the defaults below already match
# docker-compose.yml - you only need to fill in ZEPTOMAIL_*, GOOGLE_OAUTH_*,
# GROQ_API_KEY, and JWT_SECRET to exercise every feature.

# --- Database (Neon in prod: use the pooled connection string, ?sslmode=require) ---
DB_URL=jdbc:postgresql://localhost:5432/pharmasense
DB_USERNAME=pharmasense
DB_PASSWORD=pharmasense

# --- Redis (Upstash in prod) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=pharmasense
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Google OAuth2 (console.cloud.google.com > APIs & Services > Credentials) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- ZeptoMail (OTP delivery) ---
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@pharmasense.app
ZEPTOMAIL_FROM_NAME=Pharmasense
# Set to false locally to log OTP emails to the console instead of sending real ones
ZEPTOMAIL_SEND_ENABLED=false

# --- Agentic AI (Meta Llama, hosted on Groq - console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cloudinary (profile picture uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS / frontend ---
# Prod: https://pharmasense.feuxlabs.com.ng
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

SERVER_PORT=8080
APP_LOG_LEVEL=INFO

# --- Super-admin bootstrap (set once, then you can leave it or unset it) ---
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_NAME=Platform Admin

# --- Paystack billing (dashboard.paystack.com > Settings > API Keys & Webhooks) ---
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
# Amounts in kobo (1 NGN = 100 kobo)
PAYSTACK_BASIC_PRICE_KOBO=500000
PAYSTACK_PRO_PRICE_KOBO=1500000
# Where Paystack redirects the browser after checkout (a frontend page, not this API)
PAYSTACK_CALLBACK_URL=http://localhost:3000/settings/billing
# Also register {backend URL}/api/v1/billing/webhook in the Paystack dashboard's Webhooks setting

# --- Complimentary accounts (comma-separated emails; PRO with no limits, no payment) ---
BILLING_COMPLIMENTARY_EMAILS=
